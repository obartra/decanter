node_modules/
.DS_Store
*.log

# Build output. Not committed: the deploy rebuilds from source, so the copy in
# git was never what shipped, and nobody reads a generated bundle in review.
# `npm run build` puts it back.
dist/

# git worktrees created by tooling
.claude/worktrees/

# browser test output
test-results/
playwright-report/
# the per-shard reports CI merges back into one
blob-report/
all-blob-reports/

# sound lab: candidates, pack cache and the generated page are all derived,
# see tools/sound-lab/make.mjs
tools/sound-lab/audio/
tools/sound-lab/.packs/
tools/sound-lab/index.html

# Scratch files at the root. Agents and humans both leave probes here while
# working something out, and `git add -A` will sweep one into a commit that
# passed its gate a minute earlier -- which is how a stray probe-tmp.mjs reached
# CI and failed lint on a file nobody meant to ship.
/probe*.mjs
/probe*.js
/scratch*.mjs
/scratch*.js
/tmp-*.mjs
/tmp-*.js
