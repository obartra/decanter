{
  "name": "decanter",
  "version": "1.0.0",
  "private": true,
  "description": "A water sorting puzzle that runs entirely offline.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "eslint .",
    "test": "node tests/run.mjs",
    "test:e2e": "playwright test",
    "verify:budget": "node tools/verify-budget.mjs",
    "verify:dead": "node tools/dead-code.mjs",
    "verify:pars": "node tools/verify-pars.mjs 120",
    "verify:test-budget": "node tools/verify-test-budget.mjs",
    "check": "npm run lint && npm run build && npm test && npm run verify:budget && npm run verify:dead",
    "check:all": "npm run check && npm run verify:pars && npm run test:e2e && npm run verify:test-budget",
    "pars": "node tools/pars.mjs",
    "order": "node tools/order.mjs",
    "difficulty": "node tools/difficulty.mjs",
    "brick": "node tools/brick.mjs",
    "bubble:sandbox": "node tools/bubble-sandbox.mjs",
    "bubble:survival": "node tools/bubble-survival.mjs",
    "measure:field": "node tools/measure-field.mjs",
    "casks:field": "node tools/casks-field.mjs",
    "serve": "npm run build && cd dist && python3 -m http.server 8080",
    "icons": "python3 tools/make-icons.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.8.0"
  }
}
